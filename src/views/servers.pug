extends layout

block content

  .sticky-page-head
    .page-hero
      h2.page-title= title
      p.page-subtitle #{servers.length} connected guilds

  form.content-panel.data-panel-page(method="post" action="/servers")
    if canEdit && _csrf
      input(type="hidden" name="_csrf" value=_csrf)
    .panel-header
      .panel-title-group
        span.panel-icon(aria-hidden="true")
          svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
            rect(width="16" height="16" x="4" y="4" rx="2")
            path(d="M9 9h6")
            path(d="M9 15h6")
        h3.panel-title Guild Directory
      span.panel-kicker Attachment limits default to #{defaults.channelAttachmentLimit} / #{defaults.botChannelAttachmentLimit} (max #{maxAttachments})
    table.data-table(data-sortable)
      thead
        tr
          th.rank-col(scope='col' data-sort-type='number') #
          th(scope='col') Icon
          th(scope='col' data-sort-type='text') Name
          th(scope='col' data-sort-type='number') Members
          th(scope='col' data-sort-type='date') Created
          th(scope='col' data-sort-type='date') Bot Joined
          th(scope='col') Channel limit
          th(scope='col') Bot-channel limit
      tbody
        each server, index in servers
          tr
            th.rank-col(scope='row' data-sort-value=index + 1)
              span.rank-badge= index+1
            td
              img.server-icon(src=server.icon, alt="No icon")
            td(data-sort-value=server.name)= server.name
            td(data-sort-value=server.memberCount)= server.memberCount
            td(data-sort-value=server.createdAt)= server.createdAt
            td(data-sort-value=server.joinedAt)= server.joinedAt
            if canEdit
              td
                input.form-control(
                  type="number"
                  min="1"
                  max=maxAttachments
                  name=`channelAttachmentLimit_${server.id}`
                  value=server.channelAttachmentLimit
                )
              td
                input.form-control(
                  type="number"
                  min="1"
                  max=maxAttachments
                  name=`botChannelAttachmentLimit_${server.id}`
                  value=server.botChannelAttachmentLimit
                )
            else
              td= server.channelAttachmentLimit
              td= server.botChannelAttachmentLimit
    if canEdit
      .d-flex.justify-content-end.p-3
        button.btn.btn-primary(type="submit") Save

  p &nbsp;
  p &nbsp;

  script(src="/static/sortable-table.js")
