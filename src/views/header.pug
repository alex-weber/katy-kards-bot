mixin navItem(href, label, active)
    li.nav-item
        a.nav-link.text-primary.rounded.px-3.py-2.position-relative.d-flex.align-items-center.transition(
            href=href,
            class=(active ? 'active' : '')
        )
            span.menu-text= label

mixin navGroupIcon(label, icon)
    div.nav-group-icon(aria-label=label)
        svg(xmlns='http://www.w3.org/2000/svg', viewBox='0 0 24 24', width='18', height='18', fill='none', stroke='currentColor', stroke-width='2', stroke-linecap='round', stroke-linejoin='round', aria-hidden='true')
            path(d='M20 13c0 5-3.5 7.5-7.7 8.9a1 1 0 0 1-.6 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.2-2.6a1.3 1.3 0 0 1 1.6 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1z')
            path(d='M9 12l2 2 4-4')
        span.visually-hidden= label

-
    // Admin pages grouped by what they are for. A group with more than one
    // page opens a dropdown in the navbar, and on its pages a row of section
    // tabs under the navbar switches between them; a single page stays a
    // plain link.
    const adminGroups = [
        { label: 'Content', items: [
            { href: '/commands', label: 'Custom Commands' },
            { href: '/topdeck', label: 'Top Deck' },
        ] },
        { label: 'Community', items: [
            { href: '/users', label: 'Users' },
            { href: '/servers', label: 'Guilds' },
            { href: '/roles', label: 'Roles', godOnly: true },
        ] },
        { label: 'Logs', items: [
            { href: '/messages', label: 'Commands' },
            { href: '/activity', label: 'Activity' },
        ] },
        { label: 'System', items: [
            { href: '/system', label: 'System' },
        ] },
    ]
    const isCurrent = href => currentPath.startsWith(href)
    const visibleItems = group => group.items.filter(item => !item.godOnly || (user && user.role === 'GOD'))
    const currentGroup = user && user.isManager
        ? adminGroups.find(group => visibleItems(group).length > 1 && visibleItems(group).some(item => isCurrent(item.href)))
        : null

header.header-sticky
    nav.navbar.navbar-expand-lg.text-bg-dark.border-bottom.py-2
        div.container

            button.navbar-toggler.border-primary(
                type='button',
                data-bs-toggle='collapse',
                data-bs-target='#mainNavigation',
                aria-controls='mainNavigation',
                aria-expanded='false',
                aria-label='Toggle navigation'
            )
                span.navbar-toggler-icon

            div#mainNavigation.collapse.navbar-collapse
                div.main-nav-groups.d-lg-flex.align-items-lg-center.gap-lg-4
                    div.nav-group
                        ul.navbar-nav.nav-group-items
                            +navItem('/', 'Home', currentPath.endsWith('/'))
                            +navItem('/cards', 'Cards', currentPath.startsWith('/cards'))

                    if user && user.isManager
                        div.nav-group
                            +navGroupIcon('Admin navigation', 'shield')
                            ul.navbar-nav.nav-group-items.nav-admin-groups
                                each group in adminGroups
                                    - const items = visibleItems(group)
                                    if items.length === 1
                                        +navItem(items[0].href, items[0].label, isCurrent(items[0].href))
                                    else
                                        - const groupActive = items.some(item => isCurrent(item.href))
                                        li.nav-item.dropdown.nav-admin-dropdown
                                            a.nav-link.text-primary.rounded.px-3.py-2.position-relative.d-flex.align-items-center.transition.dropdown-toggle(
                                                href='#',
                                                role='button',
                                                data-bs-toggle='dropdown',
                                                aria-expanded='false',
                                                class=(groupActive ? 'active' : '')
                                            )
                                                span.menu-text= group.label
                                            ul.dropdown-menu
                                                each item in items
                                                    li
                                                        a.dropdown-item(
                                                            href=item.href,
                                                            class=(isCurrent(item.href) ? 'active' : ''),
                                                            aria-current=(isCurrent(item.href) ? 'page' : false)
                                                        )= item.label

                div.nav-auth.ms-lg-auto.mt-3.mt-lg-0
                    if loginLink
                        a.btn.btn-primary.px-4.py-2.shadow.transition(href=`${loginLink}`) Login
                    if user
                        div.dropdown
                            button.btn.btn-outline-primary.user-menu-button.px-3.py-2.shadow.dropdown-toggle.transition(
                                type='button',
                                data-bs-toggle='dropdown',
                                aria-expanded='false'
                            )
                                img(src='https://cdn.discordapp.com/avatars/' + user.id + '/' + user.avatar + '.webp?size=64', alt='', class='rounded-circle me-2 user-avatar')
                                span.user-menu-name= user.username
                            ul.dropdown-menu.dropdown-menu-end
                                li
                                    a.dropdown-item(href='/profile') Profile
                                li
                                    form(method='post' action='/logout')
                                        if _csrf
                                            input(type='hidden' name='_csrf' value=_csrf)
                                        button.dropdown-item(type='submit') Logout

    if currentGroup
        nav.section-tabs(aria-label=`${currentGroup.label} pages`)
            div.container
                ul.section-tabs-list
                    each item in visibleItems(currentGroup)
                        li
                            a.section-tab(
                                href=item.href,
                                class=(isCurrent(item.href) ? 'active' : ''),
                                aria-current=(isCurrent(item.href) ? 'page' : false)
                            )= item.label
