extends layout

block content

  .sticky-page-head.log-sticky-head
    .page-hero
      h2.page-title= title
      p.page-subtitle #{totalCount} recorded actions

    form#filterForm.filter-panel(method="get" action="")
      .row.mb-3
        .col-md-3
          label.form-label(for="area") Area:
          select#area.form-select(name="area")
            option(value="" selected=!area) All
            each option in areas
              option(value=option.value selected=(area === option.value))= option.label
        .col-md-4
          label.form-label(for="actor") By:
          input#actor.form-control(type="text" name="actor" value=actor maxlength="40")
        .col-md-2.align-self-end
          button.btn.btn-primary.me-2(type="submit") Filter
          a.btn.btn-outline-secondary(href="/activity") Reset

  .content-panel.data-panel-page.log-data-panel
    .panel-header
      .panel-title-group
        span.panel-icon(aria-hidden="true")
          svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
            path(d="M3 3v5h5")
            path(d="M3.05 13A9 9 0 1 0 6 5.3L3 8")
            path(d="M12 7v5l4 2")
        h3.panel-title Website Activity Log
      span.panel-kicker Page #{page} / #{totalPages}
    table.data-table.align-middle
      thead
        tr
          th(scope='col') When
          th(scope='col') By
          th(scope='col') Area
          th(scope='col') Action
          th(scope='col') Target
          th(scope='col') From → To
      tbody
        if rows.length
          each row in rows
            tr
              td.text-nowrap #{row.timestamp}
              td #{row.actor}
              td
                span.badge.text-bg-info= row.areaLabel
              td
                span.badge(class=row.action === 'delete' ? 'text-bg-danger' : (row.action === 'create' ? 'text-bg-success' : 'text-bg-secondary'))= row.action
              td.break-all
                if row.targetUserId
                  a.data-link(href=`/profile/${row.targetUserId}`)= row.target
                else
                  span= row.target
              td.break-all
                if row.oldValue || row.newValue
                  - const statusClass = value => row.area === 'users' && row.action === 'status' ? `audit-status-${value}` : ''
                  span.audit-old(class=statusClass(row.oldValue)) #{row.oldValue || '—'}
                  span.audit-arrow(aria-hidden="true")  →
                  span.audit-new(class=statusClass(row.newValue)) #{row.newValue || '—'}
        else
          tr
            td(colspan="6").text-center No activity recorded yet

  //- Pagination Controls
  if totalPages > 1
    -
      const maxPages = 10
      let start = Math.max(1, page - Math.floor(maxPages / 2))
      let end = start + maxPages - 1
      if (end > totalPages) {
        end = totalPages
        start = Math.max(1, end - maxPages + 1)
      }
      const pages = []
      for (let i = start; i <= end; i++) pages.push(i)
      const pageHref = number => `?area=${encodeURIComponent(area)}&actor=${encodeURIComponent(actor)}&page=${number}`

    nav.mt-4
      ul.pagination.justify-content-center
        if page > 1
          li.page-item
            a.page-link(href=pageHref(page - 1)) Previous
        else
          li.page-item.disabled
            span.page-link Previous

        each i in pages
          if i === page
            li.page-item.active
              span.page-link #{i}
          else
            li.page-item
              a.page-link(href=pageHref(i)) #{i}

        if page < totalPages
          li.page-item
            a.page-link(href=pageHref(page + 1)) Next
        else
          li.page-item.disabled
            span.page-link Next

  //- Extra spacing at bottom to avoid footer overlap
  .my-5
