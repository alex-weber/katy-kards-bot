DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/URL?schema=public"
DISCORD_TOKEN="YOUR_TOKEN"
DISCORD_CLIENT_ID="YOUR_CLIENT_ID"
DISCORD_AUTH_URL="URL_FOR_AUTH"

KARDS_API_URL="https://herokuapi.kards.com/graphql"

# Prefix for the legacy text commands. Slash commands are unaffected.
DEFAULT_PREFIX="!"

TELEGRAM_TOKEN="YOUR_TOKEN"
REDISCLOUD_URL="URL_TO_REDIS_SERVER"
# Image host used to re-host Discord attachments and admin-uploaded custom
# command images. Both must be set, or re-hosting is skipped silently.
IMG_UPLOAD_API_KEY="key"
IMG_UPLOAD_API_ENDPOINT="https://your-image-host/upload"
# Hosts the bot may download images from, comma-separated. Discord's CDN is
# always allowed; this is where the host your image uploader serves finished
# images from goes — that is the host in the URLs it returns, which is often
# not the API endpoint's own host. Exact hosts or *.example.com patterns.
# An image on any other host is refused: these URLs come out of stored custom
# commands, and fetching an arbitrary one server-side is a request forgery.
IMAGE_ALLOWED_HOSTS="your-image-host.com"
#WEB
# Public base URL of the web app (serves /terms and /privacy). Used to link the
# hosted Terms & Privacy pages from the bot's !terms and !privacy messages.
# Leave unset to show the summary text without links.
WEB_BASE_URL="https://your-bot-domain"
SESSION_SECRET="Very secret"
# 30 days
COOKIE_MAX_AGE="2592000000"
# 15 minutes
WEB_RATE_LIMIT_WINDOW_MS=900000
# requests per rate limit window
WEB_RATE_LIMIT_MAX=300
#BROWSERLESS
BROWSERLESS_API_KEY="YOUR_KEY"
BROWSERLESS_HOST="production-ams.browserless.io"
# Screenshot request timeout in MILLISECONDS. Replaces the old
# SCREENSHOT_TIMEOUT, which was seconds and is no longer read by anything —
# if your environment still sets it, switch it over rather than copying the
# value across.
BROWSERLESS_TIMEOUT=10000
# Parallel screenshot requests per Browserless key.
SCREENSHOT_CONCURRENCY=2
#VARIABLES
STATS_DIVIDER=500
# Longest message the bot will send before splitting it (Discord's cap is 2000).
MESSAGE_MAX_LENGTH=1950

# historical (<= yesterday) stats cache, 1 day - immutable, only bounds memory
CACHE_HISTORICAL_EXPIRE=86400
# Memory chart keeps the latest N process memory samples. 12 hours
MEMORY_USAGE_SAMPLE_LIMIT=60
# Memory sampling interval in minutes.
MEMORY_USAGE_SAMPLE_INTERVAL_MINUTES=10
# Default RSS warning threshold in MB. GOD users can override this from /system.
MEMORY_USAGE_THRESHOLD_MB=512
# Runtime RSS limit line in MB.
MEMORY_AVAILABLE_MB=562
# Redis memory available in MB.
REDIS_MEMORY_AVAILABLE_MB=30
# Warn when a memory metric increases by this many MB between two samples.
MEMORY_USAGE_JUMP_THRESHOLD_MB=64

SYNC_BATCH_SIZE=5
# Give up on a card sync that has not finished after this long, in MILLISECONDS.
# Only a safety net — it releases the system page's sync button if the sync
# process wedges. 15 minutes.
SYNC_TIMEOUT_MS=900000
# How many past syncs the system page's log table keeps.
SYNC_HISTORY_LIMIT=20
# bot message requirements
LIMIT=5
MIN_STR_LEN=2
MAX_STR_LEN=4000
SLOW_MODE_INTERVAL=5000

# CACHE EXPIRATION (in seconds)
# 30 days
REDIS_EXP_DECK=2592000
# 30 days
REDIS_EXP_SYNONYM=2592000
# 90 days
REDIS_EXP_SEARCH=7776000
# 7 days
REDIS_EXP_USER=604800
# 1 hour
REDIS_EXP_PERMISSION=3600
# 10 minutes
REDIS_EXP_PAGINATION=600
# 90 days
REDIS_EXP_TELEGRAM=7776000
# 5 minutes
REDIS_EXP_PROFILE=300
# 1 day - how often a legacy prefix-command user is nudged toward slash commands
REDIS_EXP_DEPRECATION=86400
# when text commands stop working, shown as a Discord relative timestamp in the nag
DEPRECATION_DEADLINE=2026-08-02T12:00:00Z
CACHE_PAGE_EXPIRE=300
CACHE_API_EXPIRE=300
# 5 minutes
CACHE_TOPDECK_PAGE_EXPIRE=300
