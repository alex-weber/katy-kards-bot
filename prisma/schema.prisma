generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int            @id @default(autoincrement())
  discordId String         @unique
  name      String?
  language  String
  status    String
  messages  Message[]
  auditLogs UserAuditLog[]
  role      String?
  mode      String?
  reactions Boolean?       @default(true)
  createdAt DateTime?      @default(now())
  tdGames   Int?
  tdWins    Int?
  tdLoses   Int?
  tdDraws   Int?
}

// Audit trail for a user's status/role changes, whether an admin makes the
// change from the dashboard or the user makes it themselves (accepting or
// declining the Terms of Service). `actor` is the admin's username, or the
// literal "self" for a user-initiated change. Only the users page reads this,
// showing the most recent entries.
model UserAuditLog {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  field     String
  oldValue  String?
  newValue  String?
  actor     String
}

model Message {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
}

model Synonym {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model Card {
  id            Int      @id @default(autoincrement())
  cardId        String   @unique
  importId      String
  imageURL      String
  thumbURL      String
  set           String
  title         String
  text          String?
  type          String
  attack        Int?
  defense       Int?
  kredits       Int
  operationCost Int?
  rarity        String
  faction       String
  attributes    String?
  exile         String?
  reserved      Boolean?
  fullText      String?
}

model Topdeck {
  id        Int      @id @default(autoincrement())
  channelID String
  startTime DateTime @default(now())
  state     String
  player1   String
  player2   String?
  winner    String?
  loser     String?
  log       String?
  kredits   Int?
  unitType  String?
}
